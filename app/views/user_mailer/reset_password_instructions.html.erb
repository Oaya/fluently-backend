<!DOCTYPE html>
<html>
  <head>
    <meta content="text/html; charset=UTF-8" http-equiv="Content-Type" />
    <style>
      body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: #f5f4f9; margin: 0; padding: 40px 20px; }
      .card { background: #ffffff; border-radius: 12px; max-width: 480px; margin: 0 auto; padding: 40px; }
      .logo { display: flex; align-items: center; gap: 8px; margin-bottom: 32px; }
      .logo-icon { background: #5c4b99; border-radius: 8px; width: 36px; height: 36px; display: flex; align-items: center; justify-content: center; }
      .logo-text { font-size: 18px; font-weight: 600; color: #1a1a2e; }
      h1 { font-size: 20px; font-weight: 600; color: #1a1a2e; margin: 0 0 8px; }
      p { font-size: 15px; color: #6b7280; line-height: 1.6; margin: 0 0 20px; }
      .btn { display: block; background: #5c4b99; color: #ffffff; text-decoration: none; border-radius: 8px; padding: 14px 24px; text-align: center; font-size: 15px; font-weight: 500; margin: 24px 0; }
      .note { font-size: 13px; color: #9ca3af; }
      .url { font-size: 12px; color: #9ca3af; word-break: break-all; }
      hr { border: none; border-top: 1px solid #f0f0f0; margin: 24px 0; }
    </style>
  </head>
  <body>
    <div class="card">
      <div class="logo">
        <div class="logo-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 8l6 6 6-6"/>
          </svg>
        </div>
        <span class="logo-text">Fluently</span>
      </div>

      <h1>Reset your password</h1>
      <p>Hi <%= @user.first_name %>,</p>
      <p>
        We received a request to reset the password for your Fluently account.
        Click the button below to choose a new password. This link expires in
        <strong>30 minutes</strong>.
      </p>

      <a href="<%= @reset_url %>" class="btn">Reset password</a>

      <p class="note">
        If you didn't request a password reset, you can safely ignore this
        email — your password won't change.
      </p>

      <hr />

      <p class="note">If the button doesn't work, copy and paste this link into your browser:</p>
      <p class="url"><%= @reset_url %></p>
    </div>
  </body>
</html>
